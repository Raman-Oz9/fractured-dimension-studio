# Cloudflare Workers AI image generation
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Primary image model; defaults to FLUX.1 Schnell
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Reference-capable model used for character sheets and reference-conditioned shots.
CLOUDFLARE_REFERENCE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# Ordered fallback models (comma-separated). Beta models may not be enabled on every account.
CLOUDFLARE_FALLBACK_MODELS=@cf/bytedance/stable-diffusion-xl-lightning,@cf/stabilityai/stable-diffusion-xl-base-1.0

# Optional keys for the free public backup image providers (raise rate limits; not required)
OVH_AI_TOKEN=
HORDE_API_KEY=

# VoiceStudio.sh API server (add these as GitHub Actions repository secrets)
VOICESTUDIO_BASE_URL=
VOICESTUDIO_API_KEY=
VOICESTUDIO_VOICE=George
VOICESTUDIO_MODEL=tts-1
VOICESTUDIO_SPEED=0.92

# Reserved for the future YouTube publishing integration.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
